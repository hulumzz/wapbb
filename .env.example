NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
WEB_ORIGIN=http://localhost:5173

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-admin-minimal-8-karakter
AUTH_SECRET=ganti-secret-jwt-yang-random-minimal-24-karakter

INTERNAL_DISPATCH_SECRET=ganti-dengan-secret-yang-panjang
WA_SESSION_ENCRYPTION_KEY=ganti-dengan-secret-enkripsi-minimal-32-karakter
# Optional: server-to-server SIDDes only. Distinct random secrets, at least 32 characters.
SID_OPERATOR_API_KEY=
SID_ADMIN_API_KEY=
DEFAULT_BATCH_SIZE=10
PROCESSING_TIMEOUT_MINUTES=15
RETRY_DELAY_SECONDS=60
# Aktifkan sesudah migration dan pilot; kebijakan ini membatasi volume, bukan jaminan anti-ban.
WA_SAFETY_ENABLED=false
WA_SAFETY_MIN_DELAY_SECONDS=45
WA_SAFETY_MAX_DELAY_SECONDS=120
WA_SAFETY_MAX_PER_MINUTE=1
WA_SAFETY_MAX_PER_HOUR=12
WA_SAFETY_MAX_PER_DAY=120
WA_SAFETY_RECONNECT_COOLDOWN_SECONDS=60
DEFAULT_BANNER_URL=https://i.ibb.co.com/fVFQc0HD/Chat-GPT-Image-16-Sep-2026-11-08-14-1-2.png

# Kill switch tombol tindakan. Aktifkan setelah pilot pada perangkat target.
INTERACTIVE_CTA_ENABLED=false
INTERACTIVE_CTA_LABEL=Buka informasi
INTERACTIVE_CTA_FOOTER=Informasi resmi desa
