{
  "name": "@wapbb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "npm run build && node dist/db/migrate.js",
    "db:migrate:compiled": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^17.2.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "link-preview-js": "^5.0.0",
    "ipaddr.js": "^2.2.0",
    "sharp": "0.35.4",
    "pg": "8.23.0",
    "qrcode": "^1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "4.23.13",
    "typescript": "^5.9.2"
  }
}
